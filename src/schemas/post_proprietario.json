{
  "title": "PostProprietario",
  "type": "object",
  "properties": {
    "documento": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$",
          "maxLength": 14
        },
        {
          "pattern": "^[0-9A-Z]{2}\\.[0-9A-Z]{3}\\.[0-9A-Z]{3}/[0-9A-Z]{4}-[0-9]{2}$",
          "maxLength": 18
        }
      ]
    },
    "nome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f\\ud800-\\udfff]"
      }
    }
  },
  "required": [
    "documento",
    "nome"
  ],
  "additionalProperties": false
}
